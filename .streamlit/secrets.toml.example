# Sleeper Cell — Streamlit secrets (copy to secrets.toml; never commit secrets.toml)
#
# Pre-fill your league/draft so you don't have to type them every run.
# All values here are READ ONLY in Sleeper's public API — there's no auth token,
# so this isn't sensitive in the usual sense. But .streamlit/secrets.toml is
# gitignored so commit hygiene is preserved.

[sleeper]
league_id = "1354245085549592576"   # Trade Whores
draft_id  = "1354245089513201664"
user_id   = "1032591150932180992"   # TBanks44 — used to auto-detect "your" roster

# Optional: gate the deployed app behind a password. Set this on Streamlit Cloud
# (Manage app → Settings → Secrets). Leave unset for local dev — the app opens normally.
# Share the password with the 2-3 people you want to give access to.
# [auth]
# password = "pick-something-memorable"
